   "versionNonce": 1347155477,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A bug nothing could see until something branched",
   "originalText": "A bug nothing could see until something branched",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "type": "text",
   "id": "s8_bugb",
   "x": 880,
   "y": 9666.25,
   "width": 596.4,
   "height": 70.0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 1486069813,
   "version": 1,
   "versionNonce": 563941388,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Until Tier 3, load() read the file top to bottom and ignored parent_id.\nFine for a straight line. With a fork it returns BOTH attempts glued\ntogether: a chat that never happened. The file format was right all\nalong (parent_id since Tier 2); only the reader was wrong.",
   "originalText": "Until Tier 3, load() read the file top to bottom and ignored parent_id.\nFine for a straight line. With a fork it returns BOTH attempts glued\ntogether: a chat that never happened. The file format was right all\nalong (parent_id since Tier 2); only the reader was wrong.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
