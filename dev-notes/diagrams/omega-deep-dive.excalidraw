  {
   "type": "text",
   "id": "s2_nastyb",
   "x": 1020,
   "y": 2777.5,
   "width": 315.0,
   "height": 93.75,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 1704429314,
   "version": 1,
   "versionNonce": 1978911330,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Most bugs break one request.\nThis one breaks every request after\nit. Retrying cannot help: the saved\nchat itself is invalid, so it fails\nthe same way each time.",
   "originalText": "Most bugs break one request.\nThis one breaks every request after\nit. Retrying cannot help: the saved\nchat itself is invalid, so it fails\nthe same way each time.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
