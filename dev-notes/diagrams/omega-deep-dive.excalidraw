  {
   "type": "text",
   "id": "s1_why2",
   "x": 960,
   "y": 1661.0,
   "width": 351.0,
   "height": 93.75,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
