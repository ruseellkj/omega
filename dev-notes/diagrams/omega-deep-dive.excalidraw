  {
   "type": "text",
   "id": "s6_left",
   "x": 880,
   "y": 7316.0,
   "width": 445.2,
   "height": 52.5,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 1940885782,
   "version": 1,
   "versionNonce": 1471461483,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A bookmark saves everything to its LEFT as one piece.\nChange one character early, and every piece after\nit must be paid for again.",
   "originalText": "A bookmark saves everything to its LEFT as one piece.\nChange one character early, and every piece after\nit must be paid for again.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "type": "text",
   "id": "s6_two",
   "x": 880,
   "y": 7386.0,
   "width": 462.0,
   "height": 52.5,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 1878056810,
   "version": 1,
   "versionNonce": 1691252313,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Why two bookmarks in the chat: Anthropic looks back at\nmost 20 blocks from a bookmark. One long turn can push\nlast time's save out of reach; bookmark 3 points at it.",
   "originalText": "Why two bookmarks in the chat: Anthropic looks back at\nmost 20 blocks from a bookmark. One long turn can push\nlast time's save out of reach; bookmark 3 points at it.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "type": "text",
   "id": "s6_sep",
   "x": 880,
   "y": 7456.0,
   "width": 445.2,
   "height": 52.5,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 672014537,
   "version": 1,
   "versionNonce": 202971408,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Why tools and system get their own: they change at\ndifferent speeds. Editing OMEGA.md changes the system\npart, and the tools bookmark still pays off.",
   "originalText": "Why tools and system get their own: they change at\ndifferent speeds. Editing OMEGA.md changes the system\npart, and the tools bookmark still pays off.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
