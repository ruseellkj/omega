  {
   "type": "text",
   "id": "s8_mw",
   "x": 700,
   "y": 9776.25,
   "width": 579.6,
   "height": 52.5,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 874325428,
   "version": 1,
   "versionNonce": 664931879,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Everything to the right of a mark is new. After each event the\nharness masks it, then writes it, then moves the mark. The loop and\nrepair_orphans() just add to the list; neither knows the marks exist.",
   "originalText": "Everything to the right of a mark is new. After each event the\nharness masks it, then writes it, then moves the mark. The loop and\nrepair_orphans() just add to the list; neither knows the marks exist.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
