   "angle": 0,
   "seed": 1012495448,
   "version": 1,
   "versionNonce": 700695840,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "If the loop made decisions, every new\nrule would make it longer. Instead it\nasks: 'may I?', 'what do I send?'.\nThat is why loop.py stayed at 190 lines\nthrough all of Tier 3.",
   "originalText": "If the loop made decisions, every new\nrule would make it longer. Instead it\nasks: 'may I?', 'what do I send?'.\nThat is why loop.py stayed at 190 lines\nthrough all of Tier 3.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
