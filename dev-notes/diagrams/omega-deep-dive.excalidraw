   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "If a grant covered sub-folders, one 'yes' about a\nfile in your home folder would open every folder in it.",
   "originalText": "If a grant covered sub-folders, one 'yes' about a\nfile in your home folder would open every folder in it.",
